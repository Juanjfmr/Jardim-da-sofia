{
  "name": "Jardim da Sofia",
  "short_name": "Jardim",
  "description": "Um jardim para brincar, aprender e cuidar do coelhinho Pipo. Para crianças de 3 a 5 anos.",
  "lang": "pt-BR",
  "start_url": "./",
